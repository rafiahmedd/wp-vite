{
    "name": "@rafiahmedd/wp-vite",
    "version": "1.0.1",
    "description": "Vite plugin for WordPress plugin and theme development",
    "type": "module",
    "main": "./js/src/index.js",
    "exports": {
        ".": {
            "types": "./types/index.d.ts",
            "default": "./js/src/index.js"
        }
    },
    "types": "./types/index.d.ts",
    "files": [
        "js/src",
        "types"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "test:syntax": "node --input-type=module < js/src/index.js && echo 'JS syntax OK'",
        "test:js": "node js/test/dev-manifest-preserved.mjs"
    },
    "peerDependencies": {
        "vite": ">=4.0.0"
    },
    "keywords": [
        "wordpress",
        "vite",
        "hmr",
        "react",
        "plugin",
        "theme",
        "assets"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/rafiahmedd/wp-vite.git"
    },
    "homepage": "https://github.com/rafiahmedd/wp-vite#readme",
    "bugs": "https://github.com/rafiahmedd/wp-vite/issues",
    "publishConfig": {
        "access": "public"
    }
}
