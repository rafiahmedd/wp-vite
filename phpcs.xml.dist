<?xml version="1.0"?>
<ruleset name="WP Vite">
    <description>Coding standards for WP Vite — WordPress + PSR-4</description>

    <!-- Files to check -->
    <file>src</file>
    <file>tests</file>

    <!-- Exclude generated / vendor files -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/coverage/*</exclude-pattern>

    <!-- Hand-written mirrors of WordPress core signatures, not our code. -->
    <exclude-pattern>tests/Stubs/*</exclude-pattern>

    <!-- PHP version -->
    <config name="php_version" value="80000"/>

    <!-- ─── WordPress Coding Standards ─────────────────────────────────── -->
    <rule ref="WordPress">
        <!-- We use PSR-4 namespaces and class files, not WP file naming. -->
        <exclude name="WordPress.Files.FileName"/>

        <!-- We use strict types; wp_die() is wrapped in our own helpers. -->
        <exclude name="WordPress.Security.EscapeOutput.OutputNotEscaped"/>
        <!-- sprintf() inside a throw is not output; WPCS misreads it. -->
        <exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>

        <!-- Heredoc/nowdoc is used intentionally in DevServer for React preamble. -->
        <exclude name="Squiz.Strings.DoubleQuoteUsage.ContainsVar"/>

        <!-- This is a PSR-4 library with camelCase members, not WP-style
             snake_case. The property and method names are the published
             Packagist API — renaming them would be a breaking change. -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>

        <!-- Manifest reads build files on the front end, where WP_Filesystem
             (an admin-context API) is not available. -->
        <exclude name="WordPress.WP.AlternativeFunctions"/>
    </rule>

    <!-- ─── Tests: fixtures and stubs, not shipped code ─────────────────── -->
    <rule ref="WordPress">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Commenting">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>

    <!-- ─── PSR-4 class naming ──────────────────────────────────────────── -->
    <rule ref="PSR1.Classes.ClassDeclaration"/>
    <rule ref="PSR2.Namespaces.UseDeclaration"/>

    <!-- ─── Allow short-form type hints (PHP 8.0+) ──────────────────────── -->
    <rule ref="Generic.PHP.LowerCaseType"/>

    <!-- ─── Minimum PHP version for syntax checks ───────────────────────── -->
    <!-- ponytail: PHPCompatibilityWP disabled. Its only PHP 8.1+ safe release
         (dev-develop) needs phpcs ^4, but WPCS 3.x pins phpcs ^3. Re-enable
         once WPCS 4 ships. composer.json's "php": ">=8.0" is the contract.
    <rule ref="PHPCompatibilityWP">
        <properties>
            <property name="testVersion" value="8.0-"/>
        </properties>
    </rule>
    -->
</ruleset>
